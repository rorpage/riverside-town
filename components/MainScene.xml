<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <children>
    <!-- Sky: an 8 px wide gradient image stretched across the screen to save memory -->
    <Poster id="sky" width="1920" height="1080" loadDisplayMode="scaleToFill" />
    <Poster id="stars" width="1920" height="400" uri="pkg:/images/stars.png" opacity="0" />
    <Poster id="sun" width="140" height="140" />

    <!-- Parallax layers. Each strip holds two copies side by side and slides left by 1920 px, then repeats. -->
    <Group translation="[0,90]">
      <Group id="cloudsStrip">
        <Poster id="clouds1" width="1920" height="255" />
        <Poster id="clouds2" width="1920" height="255" translation="[1920,0]" />
      </Group>
    </Group>
    <Group translation="[0,295]">
      <Group id="farStrip">
        <Poster id="far1" width="1920" height="425" />
        <Poster id="far2" width="1920" height="425" translation="[1920,0]" />
        <!-- The tablecloth cloud on the flat-topped mountain, one for each far image.
             It must match TABLECLOTH_POS in tools/generate_images.py. -->
        <Poster id="tablecloth1" width="280" height="100" translation="[720,-29]" opacity="0" />
        <Poster id="tablecloth2" width="280" height="100" translation="[2640,-29]" opacity="0" />
      </Group>
    </Group>
    <Group translation="[0,400]">
      <Group id="nearStrip">
        <Poster id="near1" width="1920" height="360" />
        <Poster id="near2" width="1920" height="360" translation="[1920,0]" />
      </Group>
    </Group>
    <Group translation="[0,600]">
      <Group id="hillsStrip">
        <Poster id="hills1" width="1920" height="310" />
        <Poster id="hills2" width="1920" height="310" translation="[1920,0]" />
      </Group>
    </Group>
    <!-- The town is two different tiles, A then B, so it holds A, B, A and slides left by 3840 px.
         MainScene.brs adds the car parked at the gas station in tile B to townStrip. -->
    <Group translation="[0,550]">
      <Group id="townStrip">
        <Poster id="townA1" width="1920" height="530" />
        <Poster id="townB" width="1920" height="530" translation="[1920,0]" />
        <Poster id="townA2" width="1920" height="530" translation="[3840,0]" />
      </Group>
    </Group>

    <!-- Fireflies on summer nights. Two images fade in and out in turn. -->
    <Group id="fireflies" visible="false" translation="[0,540]">
      <Poster id="firefliesA" width="1920" height="400" uri="pkg:/images/fireflies_a.png" />
      <Poster id="firefliesB" width="1920" height="400" uri="pkg:/images/fireflies_b.png" />
    </Group>

    <!-- Cars. The far lane is added first so near-lane cars draw on top of it. -->
    <Group id="farLane" />
    <Group id="nearLane" />

    <!-- Rain or snow. Two copies stacked vertically slide down by 1080 px and repeat. -->
    <Group id="precip" visible="false">
      <Group id="precipStrip">
        <Poster id="precip1" width="1920" height="1080" />
        <Poster id="precip2" width="1920" height="1080" translation="[0,-1080]" />
      </Group>
    </Group>

    <!-- Falling leaves in fall or petals in spring. Works the same way as rain and snow. -->
    <Group id="seasonFx" visible="false">
      <Group id="seasonFxStrip">
        <Poster id="seasonFx1" width="1920" height="1080" />
        <Poster id="seasonFx2" width="1920" height="1080" translation="[0,-1080]" />
      </Group>
    </Group>

    <!-- Fog: an 8 px wide gradient stretched across the screen, like the sky -->
    <Poster id="fog" width="1920" height="1080" loadDisplayMode="scaleToFill" uri="pkg:/images/fog.png" visible="false" />

    <!-- Lightning flash during thunderstorms -->
    <Rectangle id="flash" width="1920" height="1080" color="0xFFFFFFFF" opacity="0" />

    <!-- Clock and weather panel -->
    <Group id="info" translation="[1260,60]">
      <Rectangle width="580" height="150" color="0x34495E80" />
      <Label id="clockLabel" translation="[28,20]" width="340" height="70" vertAlign="center" color="0xF8FAFCFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="54" />
      </Label>
      <Label id="tempLabel" translation="[372,20]" width="180" height="70" horizAlign="right" vertAlign="center" color="0xF8FAFCFF" text="--">
        <Font role="font" uri="font:BoldSystemFontFile" size="54" />
      </Label>
      <Label id="condLabel" translation="[28,94]" width="524" height="40" vertAlign="center" color="0xECEFF3FF">
        <Font role="font" uri="font:SystemFontFile" size="30" />
      </Label>
    </Group>

    <Animation id="cloudsAnim" repeat="true" easeFunction="linear">
      <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[[0,0],[-1920,0]]" fieldToInterp="cloudsStrip.translation" />
    </Animation>
    <Animation id="farAnim" repeat="true" easeFunction="linear">
      <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[[0,0],[-1920,0]]" fieldToInterp="farStrip.translation" />
    </Animation>
    <Animation id="nearAnim" repeat="true" easeFunction="linear">
      <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[[0,0],[-1920,0]]" fieldToInterp="nearStrip.translation" />
    </Animation>
    <Animation id="hillsAnim" repeat="true" easeFunction="linear">
      <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[[0,0],[-1920,0]]" fieldToInterp="hillsStrip.translation" />
    </Animation>
    <Animation id="townAnim" repeat="true" easeFunction="linear">
      <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[[0,0],[-3840,0]]" fieldToInterp="townStrip.translation" />
    </Animation>
    <Animation id="precipAnim" repeat="true" easeFunction="linear" duration="1">
      <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[[0,0],[0,1080]]" fieldToInterp="precipStrip.translation" />
    </Animation>

    <Animation id="seasonFxAnim" repeat="true" easeFunction="linear" duration="16">
      <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[[0,0],[0,1080]]" fieldToInterp="seasonFxStrip.translation" />
    </Animation>
    <Animation id="firefliesAnim" repeat="true" easeFunction="inOutQuad" duration="4">
      <FloatFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[0.15, 1.0, 0.15]" fieldToInterp="firefliesA.opacity" />
      <FloatFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[1.0, 0.15, 1.0]" fieldToInterp="firefliesB.opacity" />
    </Animation>
    <Animation id="tableclothAnim" repeat="false" easeFunction="inOutQuad" duration="20">
      <FloatFieldInterpolator id="tablecloth1Fade" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="tablecloth1.opacity" />
      <FloatFieldInterpolator id="tablecloth2Fade" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="tablecloth2.opacity" />
    </Animation>
    <Animation id="flashAnim" repeat="false" easeFunction="linear" duration="0.7">
      <FloatFieldInterpolator key="[0.0, 0.08, 0.18, 0.3, 1.0]" keyValue="[0.0, 0.55, 0.1, 0.4, 0.0]" fieldToInterp="flash.opacity" />
    </Animation>

    <WeatherTask id="weatherTask" />
  </children>
</component>
