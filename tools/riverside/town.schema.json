            "bitter",
            "cabin",
            "cinzel",
            "comfortaa",
            "fredoka",
            "graduate",
            "hanken",
            "josefin",
            "kaushan",
            "lora",
            "montserrat",
            "oswald",
            "pacifico",
            "playfair",
            "quicksand",
            "racing",
            "raleway",
            "script",
            "sharetech",
            "signika"
          ],
          "description": "A font from tools/fonts"
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900,
          "description": "Font weight, from 100 (thin) to 900 (black). Fonts with one weight ignore it."
        },
        "sign_size": {
          "type": "number",
          "minimum": 9,
          "maximum": 40,
          "description": "The largest text size on the sign. Long names are made smaller to fit."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "The call letters, for example \"WSQK\". A lightning bolt hangs from the first Q."
        },
        "small_line": {
          "type": "string",
          "maxLength": 30,
          "description": "A line in script below the call letters, for example \"The Squawk\""
        },
        "power": {
          "type": "string",
          "maxLength": 10,
          "description": "The station power, shown as \"<power> WATTS\" on each side of the call letters, for example \"50,000\""
        },
        "letter_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "A color written as #RRGGBB"
        },
        "tower": {
          "type": "boolean",
          "description": "A tall red lattice tower behind the station. Default true."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "pets": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "color"
        ],
        "properties": {
          "type": {
            "enum": [
              "cat",
              "guinea_pig",
              "dog"
            ]
          },
          "color": {
            "enum": [
              "black",
              "gray",
              "tabby",
              "white",
              "gray_white",
              "black_orange",
              "white_orange",
              "yellow_lab",
              "black_lab",
              "chocolate_lab",
              "beagle",
              "corgi",
              "dalmatian",
              "dachshund",
              "husky"
            ],
            "description": "cat: black, gray, tabby, white, gray_white. guinea_pig: black_orange, white_orange. dog: yellow_lab, black_lab, chocolate_lab, beagle, corgi, dalmatian, dachshund, husky."
          },
          "size": {
            "enum": [
              "regular",
              "small"
            ],
            "description": "A small animal is shown at 0.75 times the regular size. Default regular."
          }
        }
      }
    },
    "cars": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "sedan",
          "van",
          "jeep",
          "truck",
          "sports",
          "buggy"
        ]
      }
    },
    "external_config_url": {
      "type": "string",
      "maxLength": 500,
      "description": "The address of a JSON file with settings that can change without rebuilding the town, for example http://192.168.1.50:8080/riverside.json. Use https, or http for an address on the home network. Leave it empty for none."
    },
    "birthdays": {
      "type": "array",
      "maxItems": 100,
      "description": "Birthdays to show each year. The network settings file can replace this list.",
      "items": {
        "$ref": "#/$defs/birthday"
      }
    },
    "messages": {
      "type": "array",
      "maxItems": 50,
      "description": "Messages to show between two dates. The network settings file can replace this list.",
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "special_cars": {
      "type": "array",
      "uniqueItems": true,
      "description": "Cars from movies that drive by less often than the other cars and never park at the gas station. Default none.",
      "items": {
        "enum": [
          "aston",
          "herbie",
          "kitt",
          "ecto1",
          "delorean",
          "mcqueen",
          "mustang"
        ]
      }
    },
    "extras": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "airplane": {
          "type": "boolean"
        },
        "kayaks": {
          "type": "boolean"
        },
        "fireflies": {
          "type": "boolean"
        },
        "falling_leaves": {
          "type": "boolean"
        },
        "seasons": {
          "type": "boolean"
        },
        "table_mountain": {
          "type": "boolean"
        },
        "bikes": {
          "type": "boolean"
        },
        "street_lights": {
          "type": "boolean"
        },
        "christmas": {
          "type": "boolean",
          "description": "In December, Christmas lights on the buildings, wreaths on the street lights, and garland on the gazebo and the columned hall"
        },
        "christmas_lights": {
          "enum": [
            "mixed",
            "rainbow",
            "white",
            "red_white"
          ],
          "description": "The style of the Christmas lights: one style for every building, or mixed, where each building gets one of the styles"
        }
      }
    }
  },
  "$defs": {
    "where": {
      "enum": [
        "banner",
        "marquee",
        "both"
      ],
      "description": "Where the text shows: on the banner the airplane tows, on the marquee sign, or both. Default both."
    },
    "birthday": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "date"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Shown as \"Happy birthday, <name>!\""
        },
        "date": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "description": "Month and day, for example \"11-20\". On 02-29, the text shows on February 28 in years without February 29."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Text to show in place of \"Happy birthday, <name>!\""
        },
        "where": {
          "$ref": "#/$defs/where"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "from": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "description": "The first day to show the text, for example \"2026-11-26\". Without it, the text shows until the until date."
        },
        "until": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "description": "The last day to show the text. Without it, the text shows every day from the from date."
        },
        "where": {
          "$ref": "#/$defs/where"
        }
      }
    }
  }
}
