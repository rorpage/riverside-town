{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Riverside Town settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "The screensaver name in Settings > Theme > Screensavers"
    },
    "location": {
      "description": "Where the weather comes from. Give a ZIP code, or lat and lon.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zip": {
          "type": [
            "string",
            "integer"
          ]
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Za-z]{2}$"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "anyOf": [
        {
          "required": [
            "zip"
          ]
        },
        {
          "required": [
            "lat",
            "lon"
          ]
        }
      ]
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "enum": [
            "F",
            "C"
          ]
        },
        "clock": {
          "enum": [
            "12h",
            "24h"
          ]
        }
      }
    },
    "hemisphere": {
      "enum": [
        "north",
        "south"
      ],
      "description": "In the south, the seasons are moved by six months."
    },
    "buildings": {
      "type": "array",
      "description": "The buildings along the street, in order from left to right.",
      "items": {
        "anyOf": [
          {
            "type": [
              "string",
              "integer"
            ],
            "description": "A house number. The house gets a color and a font automatically."
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "house"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$",
                "description": "A color written as #RRGGBB"
              },
              "font": {
                "enum": [
                  "alegreya",
                  "amatic",
                  "bitter",
                  "cabin",
                  "cinzel",
                  "comfortaa",
                  "fredoka",
                  "graduate",
                  "hanken",
                  "josefin",
                  "kaushan",
                  "lora",
                  "montserrat",
                  "oswald",
                  "pacifico",
                  "playfair",
                  "quicksand",
                  "racing",
                  "raleway",
                  "script",
                  "sharetech",
                  "signika"
                ],
                "description": "A font from tools/fonts"
              },
              "weight": {
                "type": "integer",
                "minimum": 100,
                "maximum": 900,
                "description": "Font weight, from 100 (thin) to 900 (black). Fonts with one weight ignore it."
              },
              "sign_size": {
                "type": "number",
                "minimum": 9,
                "maximum": 40,
                "description": "The largest text size on the sign. Long names are made smaller to fit."
              },
              "number": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "width": {
                "type": "integer",
                "minimum": 110,
                "maximum": 260
              },
              "stories": {
                "enum": [
                  1,
